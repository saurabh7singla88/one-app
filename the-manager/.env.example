# ─── Database ─────────────────────────────────────────────────────────────────
# Prisma CLI needs a file: URL for schema validation (used by prisma studio/generate)
DATABASE_URL=file:./dev.db

# Runtime connection to Turso (used by the app at runtime via libsql adapter)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Desktop (Electron — DATABASE_URL is set automatically by the app to the local SQLite file.
#           TURSO_DATABASE_URL + TURSO_AUTH_TOKEN are set via the Setup > Sync page.)

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Encryption ───────────────────────────────────────────────────────────────
# 64-char hex string (32 bytes). Used to encrypt credentials stored in the DB.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your-64-char-hex-key

# ─── Integrations (JIRA, Gmail, AI) ──────────────────────────────────────────
# Configure these from the Setup page after first login.
# They are stored encrypted in the database — no env vars needed.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=47421
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ─── Logging (optional) ───────────────────────────────────────────────────────
# SERVER_LOG_PATH=/var/log/one/server.log
